{
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": "auto",
    "gradient_clipping": 1.0,
    "logging": {
        "enabled": true,
        "verbosity": 3
    },
    "zero_optimization": {
        "stage": 3,
        "overlap_comm": true,
        "contiguous_gradients": true,
        "reduce_bucket_size": 25000000,
        "stage3_max_live_parameters": 2e7,
        "stage3_max_reuse_distance": 2e7,
        "stage3_param_persistence_threshold": 5000,
        "offload_param": {
            "device": "cpu",
            "pin_memory": true
        },
        "sub_group_size": 1,
        "prefetch_bucket_size": 5000000
    },
    "offload_optimizer": {
        "device": "cpu",
        "pin_memory": true
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": "auto",
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-8,
            "weight_decay": "auto"
        }
    },
    "aio": {
        "block_size": 1048576,
        "queue_depth": 8,
        "thread_count": 1,
        "single_submit": false,
        "overlap_events": true
    },
    "fp16": {
        "enabled": "auto"
    },
    "bf16": {
        "enabled": "auto"
    },
    "activation_checkpointing": {
        "partition_activations": true,
        "contiguous_memory_optimization": false,
        "cpu_checkpointing": true,
        "number_checkpoints": null,
        "synchronize_checkpoint_boundary": false
    }
}